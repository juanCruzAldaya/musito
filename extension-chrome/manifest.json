{
  "manifest_version": 3,
  "name": "MuMagdalenas Vigía",
  "version": "0.86.10",
  "description": "Panel de estado, avisos a Discord y vigía del Helper nativo para MU Magdalenas.",
  "permissions": [
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://discordapp.com/*",
    "https://play.mumagdalenas.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vigía MuMagdalenas"
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.mumagdalenas.com/*"
      ],
      "js": [
        "modo.js",
        "paquetes.js",
        "mover.js",
        "pantalla.js",
        "bichos.js",
        "piloto.js",
        "caja.js",
        "joyas.js",
        "hechizo.js",
        "ciclo.js",
        "stats.js",
        "grupo.js",
        "golpes.js",
        "agresor.js",
        "telemetria.js",
        "vigia.js",
        "lab.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://play.mumagdalenas.com/*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_start"
    }
  ]
}